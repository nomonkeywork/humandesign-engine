{
  "name": "humandesign-engine",
  "version": "0.2.0",
  "description": "Focused Human Design chart calculator with Dream Rave, bodygraph helpers and an MCP server.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./mcp": "./src/mcp/index.js",
    "./humandesign": "./src/calculators/humandesign.js",
    "./astronomy": "./src/calculators/astronomy.js",
    "./timezone": "./src/timezone.js",
    "./dream-rave": "./src/dream-rave.js",
    "./bodygraph": "./src/bodygraph.js",
    "./bodygraph-svg": "./src/data/bodygraph-svg.js"
  },
  "bin": {
    "humandesign-engine-mcp": "src/mcp/index.js"
  },
  "files": [
    "src",
    "scripts",
    "LICENSE",
    "THIRD_PARTY_LICENSES",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "mcp": "node src/mcp/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "astronomy-engine": "^2.1.19"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nomonkeywork/humandesign-engine.git"
  }
